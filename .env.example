# Environment example

# Server
NODE_ENV=development
PORT=3000

# JWT
JWT_SECRET=changeme
JWT_EXPIRY=3600
REFRESH_TOKEN_SECRET=changeme
REFRESH_TOKEN_EXPIRY=604800

# S3 (for resume uploads)
S3_BUCKET=navil-resumes
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=YOUR_KEY
S3_SECRET_ACCESS_KEY=YOUR_SECRET

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxx

# Exchange rates provider (for localized price display)
EXCHANGE_RATE_API_KEY=your_key_here
EXCHANGE_RATE_PROVIDER=exchangerate_host
DEFAULT_CURRENCY=NGN
ENABLE_AUTO_CURRENCY=true

# Other
DATABASE_URL=postgres://user:pass@localhost:5432/navil
REDIS_URL=redis://localhost:6379
